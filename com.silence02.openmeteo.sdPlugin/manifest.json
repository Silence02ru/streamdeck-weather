{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.silence02.openmeteo",
	"Name": "Погода — Open-Meteo и Яндекс",
	"Version": "1.4.0.0",
	"Author": "Silence02ru",
	"Description": "Текущая погода и прогноз на сегодня прямо на кнопке Stream Deck. Источники: Open-Meteo (без ключа) или Яндекс Погода (бесплатный ключ). Несколько городов, поиск по названию, три вида кнопки.",
	"Icon": "imgs/plugin/icon",
	"URL": "https://github.com/Silence02ru/streamdeck-weather",
	"Category": "Погода",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"Nodejs": {
		"Version": "20"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Actions": [
		{
			"UUID": "com.silence02.openmeteo.weather",
			"Name": "Погода",
			"Icon": "imgs/actions/weather/icon",
			"Tooltip": "Текущая погода. Нажатие — сменить вид, долгое нажатие — обновить",
			"PropertyInspectorPath": "ui/weather.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/weather/key",
					"ShowTitle": false
				}
			]
		}
	]
}